{
  "mcpServers": {
    "localgen": {
      "type": "stdio",
      "command": "${CLAUDE_PROJECT_DIR:-.}/.venv/Scripts/python.exe",
      "args": ["-m", "app.mcp_server"],
      "env": {
        "PYTHONPATH": "${CLAUDE_PROJECT_DIR:-.}",
        "LOCALIMAGEGEN_URL": "${LOCALIMAGEGEN_URL:-http://127.0.0.1:8765}",
        "LOCALIMAGEGEN_AUTOSPAWN": "${LOCALIMAGEGEN_AUTOSPAWN:-1}"
      },
      "timeout": 900000
    }
  }
}
